---
import { formatDate, estimateReadingTime } from '../lib/format';

interface Props {
  slug: string;
  title: string;
  excerpt: string;
  date: Date;
  tags: string[];
  body?: string;
}

const { slug, title, excerpt, date, tags, body } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a
  href={`${base}writing/${slug}`}
  class="group block py-6 transition-colors duration-150"
>
  <div class="flex items-baseline justify-between gap-4 text-xs" style="color: var(--muted)">
    <span>{formatDate(date)}</span>
    <span class="hidden sm:inline">{estimateReadingTime(body)}</span>
  </div>
  <h3 class="mt-2 text-lg font-medium tracking-tight transition-colors duration-150 group-hover:text-[var(--accent)]">
    {title}
  </h3>
  <p class="mt-1.5 text-[0.9375rem]" style="color: var(--muted)">{excerpt}</p>
  {tags.length > 0 && (
    <div class="mt-3 flex gap-3 font-mono text-xs" style="color: var(--muted)">
      {tags.map((tag) => <span>{tag}</span>)}
    </div>
  )}
</a>
