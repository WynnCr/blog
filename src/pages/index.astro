---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Amrit">
  <section class="pt-4 pb-4">
    <h1 class="text-[2.25rem] font-medium leading-[1.15] tracking-tight sm:text-[2.5rem]">
      I build software, learn things,<br />and write about the process.
    </h1>
    <p class="mt-4 max-w-[46ch] text-[1.0625rem]" style="color: var(--muted)">
      Systems programming, Linux, and the occasional detour into game engines
      and fiction. Currently living in NixOS with Niri.
    </p>
    <div class="mt-6 flex gap-5 text-sm">
      <a href="https://github.com/WynnCr" target="_blank" rel="noreferrer noopener" class="prose-link">GitHub</a>
      <a href={`${base}writing`} class="prose-link">Writing</a>
    </div>
  </section>

  <section class="mt-16 border-t pt-2" style="border-color: var(--border)">
    <div class="flex items-baseline justify-between">
      <h2 class="text-sm font-medium" style="color: var(--muted)">Recent writing</h2>
      <a href={`${base}writing`} class="text-sm prose-link">All posts</a>
    </div>
    <div class="divide-y" style="--tw-divide-opacity: 1; border-color: var(--border)">
      {posts.map((post) => (
        <div class="border-b last:border-none" style="border-color: var(--border)">
          <PostRow
            slug={post.id}
            title={post.data.title}
            excerpt={post.data.excerpt}
            date={post.data.date}
            tags={post.data.tags}
            body={post.body}
          />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
