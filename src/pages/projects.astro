---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Projects" description="Things Amrit has built.">
  <section class="pt-4">
    <h1 class="text-2xl font-medium tracking-tight">Projects</h1>
    <p class="mt-2 text-[0.9375rem]" style="color: var(--muted)">
      Mostly Linux tooling and things I wanted for my own setup.
    </p>

    <div class="mt-8 divide-y" style="border-color: var(--border)">
      {projects.map((project) => (
        <div class="border-b py-6 last:border-none" style="border-color: var(--border)">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-lg font-medium tracking-tight">{project.data.title}</h2>
            {project.data.href && (
              <a href={project.data.href} target="_blank" rel="noreferrer noopener" class="text-sm prose-link shrink-0">
                repo &rarr;
              </a>
            )}
          </div>
          <p class="mt-1.5 text-[0.9375rem]" style="color: var(--muted)">{project.data.description}</p>
          {project.data.tags.length > 0 && (
            <div class="mt-3 flex gap-3 font-mono text-xs" style="color: var(--muted)">
              {project.data.tags.map((tag) => <span>{tag}</span>)}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
